# Configuration for Workflow Analyzer.
# Copy to your environment (or a .env loader of your choice); nothing here is read from this file directly.
# The PHP dashboard reads these with getenv(), the Python backend with os.environ.

# MySQL database shared by the dashboard and the backend
WFA_DB_HOST=localhost
WFA_DB_USER=root
WFA_DB_PASSWORD=
WFA_DB_NAME=workflow_analyzer

# Microsoft app registration used for the Outlook / Graph OAuth flow
# https://portal.azure.com -> App registrations
WFA_CLIENT_ID=
WFA_CLIENT_SECRET=

WFA_CONSENT_URL=http://localhost:5000
WFA_DASHBOARD_URL=http://localhost:8000
